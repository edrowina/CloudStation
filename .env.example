# ==============================================================================
# CloudStation · Variables de Entorno de Ejemplo
# ==============================================================================

# Puerto en el que corre el servidor backend (En Railway se detecta automáticamente)
PORT=3000

# Entorno de ejecución: 'development' para pruebas locales o 'production' para Railway
NODE_ENV=production

# URL pública de tu aplicación (usada para generar los enlaces y el código QR del celular)
# Ejemplo en local: http://localhost:3000
# Ejemplo en ngrok: https://xxxx.ngrok-free.app
# Ejemplo en Railway: https://nube.tudominio.com o https://xxxx.up.railway.app
APP_URL="https://nube.tudominio.com"

# Directorio de almacenamiento de datos persistentes (proyectos, fotos, base de datos)
# En Railway se recomienda montar un Volume en: /app/data
DATA_DIR="/app/data"

# Clave de API de Gemini (Inyectada automáticamente en Google AI Studio si se requiere)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
